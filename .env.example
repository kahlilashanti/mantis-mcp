# Mantis API Configuration
# Copy to .env and fill in your values

# Required: Base URL of your Mantis API
# AWS Lambda:     https://{api-id}.execute-api.{region}.amazonaws.com
# Vercel:         https://your-api.vercel.app
# Custom server:  https://api.yourdomain.com
MANTIS_API_URL=

# Optional: Authentication token for API requests
# Cognito JWT or guest token from /accounts/guest endpoint
MANTIS_AUTH_TOKEN=

# Optional: Request timeout in milliseconds (default: 30000)
MANTIS_API_TIMEOUT=30000

# Optional: Default showroom ID for validation
# Used by validateSetup tool if not provided in arguments
MANTIS_SHOWROOM_ID=

# Optional: Default organization ID for multi-tenancy
MANTIS_ORGANIZATION_ID=
